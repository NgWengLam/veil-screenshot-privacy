{
  "name": "veil-screenshot-privacy",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Local-only screenshot redaction browser extension.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node tests/e2e/editor.test.mjs",
    "verify": "npm run check && npm test && npm run build",
    "vendor:ocr": "node scripts/vendor-ocr.mjs"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0"
  }
}
